# ============================================
# Supabase
# ============================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================
# PortOne V2 결제 (토스페이먼츠)
# ============================================

# [클라이언트 노출 OK] 상점 ID
# PortOne 콘솔 > 상점 관리 > 상점 ID
NEXT_PUBLIC_PORTONE_STORE_ID=store-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# [클라이언트 노출 OK] 채널 키 (테스트/운영 키를 환경별로 분리하세요)
# PortOne 콘솔 > 결제 연동 > 채널 관리 > 채널 키
# 테스트 환경: 테스트용 채널키, 프로덕션: 운영용 채널키를 배포 환경변수에 설정합니다.
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=channel-key-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# [서버 전용 - 절대 노출 금지] PortOne V2 API Secret
# PortOne 콘솔 > 내 정보 > API Keys > V2 API Secret
# 서버에서 `Authorization: PortOne <SECRET>` 스킴으로 사용됩니다.
PORTONE_API_SECRET=your_v2_api_secret

# [서버 전용 - 절대 노출 금지] 웹훅 시크릿
# PortOne 콘솔 > 결제 연동 > 웹훅 관리 > 웹훅 등록 후 발급되는 시크릿
# Standard Webhooks 스펙(webhook-id / webhook-timestamp / webhook-signature)에
# 따른 서명 검증에 사용됩니다.
# 프로덕션(NODE_ENV=production)에서는 반드시 설정되어 있어야 합니다 (미설정 시 서버 기동 실패).
PORTONE_WEBHOOK_SECRET=your_webhook_secret

# ============================================
# Naver OAuth (Supabase 대시보드의 Custom OIDC Provider로 설정)
# ============================================
# NAVER_CLIENT_ID와 NAVER_CLIENT_SECRET은 Next.js 환경변수가 아닌
# Supabase 대시보드 > Authentication > Providers에서 직접 입력해야 합니다.
# 네이버 개발자센터: https://developers.naver.com/apps/#/register

# [선택] PortOne 본인인증 채널 키 (휴대폰 본인확인)
# 본인인증 채널 추가 시 사용 (KCB/나이스 본인인증 별도 계약 필요)
NEXT_PUBLIC_PORTONE_IDENTITY_CHANNEL_KEY=

# ============================================
# Naver OAuth (Supabase 대시보드의 Custom OIDC Provider로 설정)
# ============================================
# NAVER_CLIENT_ID와 NAVER_CLIENT_SECRET은 Next.js 환경변수가 아닌
# Supabase 대시보드 > Authentication > Providers에서 직접 입력해야 합니다.
# 네이버 개발자센터: https://developers.naver.com/apps/#/register

# ============================================
# Resend (이메일 발송)
# ============================================
# https://resend.com/api-keys 에서 발급
# 도메인 인증 후 from 주소를 자기 도메인으로 변경
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=뚝딱 <noreply@ttukddak.kr>

# ============================================
# Sentry (에러 트래킹)
# ============================================
# https://sentry.io 가입 후 Next.js 프로젝트 생성 시 발급
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ============================================
# Google Analytics 4
# ============================================
# https://analytics.google.com 에서 측정 ID(G-XXXXXXXXXX) 발급
NEXT_PUBLIC_GA_ID=

# ============================================
# Vercel Cron 보안 (자동 구매확정 등)
# ============================================
# 임의의 긴 랜덤 문자열 (예: openssl rand -hex 32)
# Vercel 환경변수에 등록하면 Vercel Cron이 자동으로 Authorization 헤더에 포함시킵니다.
CRON_SECRET=

# ============================================
# App
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
