{
  "name": "ai-video-market",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node scripts/preopen-smoke.mjs",
    "test:flow": "node scripts/preopen-flow-smoke.mjs",
    "audit": "npm audit --omit=dev",
    "check:remote": "node scripts/preopen-remote-check.mjs",
    "db:apply:preopen": "powershell -ExecutionPolicy Bypass -File scripts/apply-preopen-migrations.ps1",
    "db:rehearse:fresh": "powershell -ExecutionPolicy Bypass -File scripts/rehearse-fresh-db.ps1",
    "verify:preopen": "npm run type-check && npm run lint && npm run build && npm run test && npm run test:e2e && npm run audit",
    "verify:100": "npm run verify:preopen && npm run db:rehearse:fresh && npm run check:remote && npm run test:flow"
  },
  "dependencies": {
    "@portone/browser-sdk": "^0.1.4",
    "@portone/server-sdk": "^0.19.0",
    "@react-email/render": "^2.0.7",
    "@sentry/nextjs": "^10.49.0",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.102.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "6.1.3",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
